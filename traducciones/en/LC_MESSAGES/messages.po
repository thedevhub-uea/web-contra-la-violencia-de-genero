msgid_plural "Se han retirado %(num)d publicaciones que ya estaban en pantalla."
msgstr[0] "%(num)d post that was already on screen has been removed."
msgstr[1] "%(num)d posts that were already on screen have been removed."

msgid "Se han enviado muchos avisos desde esta red. Espera unos minutos."
msgstr ""
"Too many reports have been sent from this network. Please wait a few "
"minutes."

msgid "Segundos de cada página del foro (una pregunta con sus respuestas)."
msgstr "Seconds for each forum page (one question with its answers)."

msgid "Segundos que dura el foro antes de volver al mural. 300 = 5 min."
msgstr "Seconds the forum lasts before going back to the wall. 300 = 5 min."

msgid "Segundos que dura el mural antes de pasar al vídeo. 300 = 5 min."
msgstr "Seconds the wall lasts before moving on to the video. 300 = 5 min."

msgid ""
"Si has enviado una reflexión, aparecerá en la pantalla cuando se haya "
"revisado."
msgstr ""
"If you sent a reflection, it will appear on the screen once it has been "
"reviewed."

msgid "Si tú o alguien que conoces necesita ayuda:"
msgstr "If you or someone you know needs help:"

msgid "Siguen en la pantalla hasta que decidas: los avisos no retiran nada solos."
