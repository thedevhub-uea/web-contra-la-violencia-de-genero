#, python-format
msgid "%(num)d aviso:"
msgid_plural "%(num)d avisos:"
msgstr[0] "%(num)d report:"
msgstr[1] "%(num)d reports:"

msgid "(gratuito, 24 horas, no deja rastro en la factura)."
msgstr "(free, 24 hours, does not appear on the phone bill)."

msgid ""
"0 = los mensajes no caducan (de 0 a 240). Cuenta desde que se envía el "
"mensaje; al caducar deja de salir en el mural y en el foro, pero no se "
"borra: sigue en «Publicaciones» como «Caducado». Las reflexiones no "
"caducan. Debe durar al menos un ciclo completo de la pantalla (mural 5 "
"min + vídeo + foro 5 min, unos 16 min con el vídeo actual): si es menos, "
"un mensaje puede caducar sin haberse visto. Para pruebas se permite 1."
msgstr ""
"0 = messages never expire (from 0 to 240). It counts from the moment the "
"message is sent; once expired it stops showing on the wall and in the "
"forum, but it is not deleted: it stays under “Posts” as “Expired”. "
"Reflections do not expire. It must last at least one full screen cycle "
"(wall 5 min + video + forum 5 min, about 16 min with the current video): "
"if it is shorter, a message may expire without ever being seen. 1 is "
"allowed for testing."

msgid "Acceso restringido"
msgstr "Restricted access"

